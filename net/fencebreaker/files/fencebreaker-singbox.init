#!/bin/sh /etc/rc.common
# sing-box for fencebreaker VLESS tenants (single process, one tun inbound
# per tenant). Config is generated by fencebreakerd.
USE_PROCD=1
START=99
STOP=20

CONF=/var/run/fencebreaker/sing-box.json

start_service() {
    [ -f "$CONF" ] || {
        logger -t fencebreaker-singbox "no $CONF (no VLESS tenants?), not starting"
        return 0
    }
    command -v sing-box >/dev/null || {
        logger -t fencebreaker-singbox "sing-box binary not installed"
        return 0
    }
    procd_open_instance
    procd_set_param command /usr/bin/sing-box run -D /var/run/fencebreaker -c sing-box.json
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    stop
    start
}
