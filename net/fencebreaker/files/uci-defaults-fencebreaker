#!/bin/sh
[ -f /etc/config/fencebreaker ] || \
    cp /usr/share/fencebreaker/fencebreaker.conf /etc/config/fencebreaker

# ucitrack: LuCI Save&Apply reloads the daemon after config commits.
# The config file may not exist on fresh 25.12 installs (modern LuCI dropped
# shipping it), so create it before adding our section.
if [ ! -f /etc/config/ucitrack ]; then
    printf "config ucitrack\n" > /etc/config/ucitrack
fi

uci -q get ucitrack.@fencebreaker[-1] >/dev/null || {
    uci add ucitrack fencebreaker
    uci set ucitrack.@fencebreaker[-1].init=fencebreaker
    uci commit ucitrack
}

exit 0
