#!/bin/sh /etc/rc.common
# fencebreaker daemon: policy routing orchestrator.
USE_PROCD=1
START=99
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/fencebreakerd
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/config/fencebreaker
    procd_close_instance
}

reload_service() {
    # daemon re-applies everything on SIGHUP
    procd_send_signal fencebreaker
}

service_triggers() {
    procd_add_reload_trigger "fencebreaker"
}
