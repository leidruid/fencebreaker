#!/bin/sh /etc/rc.common
# fb-coredns: single CoreDNS instance for all fencebreaker tenants.
# The Corefile is generated by fencebreakerd; without it there is nothing to
# serve, so wait quietly until the daemon writes it.
USE_PROCD=1
START=99
STOP=15

COREFILE=/var/run/fencebreaker/Corefile

start_service() {
    [ -f "$COREFILE" ] || {
        logger -t fencebreaker-coredns "no $COREFILE yet, waiting for fencebreakerd"
        return 0
    }
    procd_open_instance
    procd_set_param command /usr/bin/fb-coredns -conf "$COREFILE"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    stop
    start
}
